# Copy this file to secret.yaml, which git ignores, and fill in your values. Choose one
# sign-in method: username and password, client_id and client_secret, or access_token.
# docs/authentication.md explains every key.
apiVersion: v1
kind: Secret
metadata:
  namespace: crossplane-system
  name: wso2is-creds
type: Opaque
stringData:
  credentials: |
    {
      "base_url": "https://id.example.com",
      "username": "admin",
      "password": "change-me"
    }
