# Copy this file to secret.yaml, which git ignores, and fill in your values. The
# ClusterProviderConfig reads the Secret in crossplane-system. A namespaced ProviderConfig
# reads a Secret with the same layout in its own namespace. docs/authentication.md
# explains every key.
apiVersion: v1
kind: Secret
metadata:
  namespace: crossplane-system
  name: wso2is-creds
type: Opaque
stringData:
  credentials: |
    {
      "base_url": "https://id.example.com",
      "username": "admin",
      "password": "change-me"
    }
