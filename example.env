# Copy this file to .env and fill in the values. .env is git-ignored.

# The WSO2 Identity Server used for tests. The Hetzner lab of terraform-provider-wso2is is at
# https://wso2is.lab.software-cloud.com. The Docker server from `task wso2:up` in that
# repository is at https://localhost:9443 (admin/admin, self-signed certificate).
WSO2IS_BASE_URL=https://localhost:9443
WSO2IS_USERNAME=admin
WSO2IS_PASSWORD=admin
# Only for servers with a self-signed certificate.
# WSO2IS_INSECURE_SKIP_VERIFY=true

# For uptest (make e2e, make uptest): the credentials JSON object for the same server, in the
# format that a ProviderConfig Secret holds. Keep the single quotes. For a server with a
# self-signed certificate, add "insecure_skip_verify": true.
UPTEST_CLOUD_CREDENTIALS='{"base_url": "https://localhost:9443", "username": "admin", "password": "admin", "insecure_skip_verify": true}'
