# Copy this file to .env and fill in the values. .env is git-ignored.

# The WSO2 Identity Server used for tests. The values below fit the server in Docker from
# `make wso2.up` (compose.yaml): https://localhost:9443, admin/admin, self-signed certificate.
# For your own server, change them.
WSO2IS_BASE_URL=https://localhost:9443
WSO2IS_USERNAME=admin
WSO2IS_PASSWORD=admin
# Only for servers with a self-signed certificate.
WSO2IS_INSECURE_SKIP_VERIFY=true

# For uptest (make e2e, make uptest): the credentials JSON object for the same server, in the
# format that a ProviderConfig Secret holds. Keep the single quotes. uptest runs the provider
# inside the kind cluster, where localhost is the provider itself, so the Docker server is
# https://wso2is:9443 here. For a server with a self-signed certificate, keep
# "insecure_skip_verify": true.
UPTEST_CLOUD_CREDENTIALS='{"base_url": "https://wso2is:9443", "username": "admin", "password": "admin", "insecure_skip_verify": true}'
